def emit(obj: dict) -> None:
    sys.stdout.write(json.dumps(obj, ensure_ascii=False) + "\n")
    sys.stdout.flush()


def render_snapshot(snap: Snapshot, cfg: dict) -> dict:
    if not snap.accounts:
        return render_error(snap.error or "no accounts found", cfg)
    out = render_waybar(snap.accounts, cfg, is_expanded(), snap.fetched_at)
    if POPOVER_OPEN.exists() and popover_pid():
        out["class"].append("open")
    if snap.error:
        out["tooltip"] = out["tooltip"].replace(
            "</tt>",
            "\n" + span(esc(f"last poll failed: {snap.error}"), cfg["colors"]["critical"]) + "</tt>",
        )
        out["class"].append("stale")
    return out


def cmd_waybar(cfg: dict) -> int:
    wake = threading.Event()
    forced = {"at": 0.0}

    def on_rerender(*_):
        wake.set()

    def on_refresh(*_):
        forced["at"] = time.time()
        wake.set()

    signal.signal(signal.SIGUSR1, on_rerender)
    signal.signal(signal.SIGUSR2, on_refresh)
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    signal.signal(signal.SIGINT, lambda *_: sys.exit(0))
    PIDS_DIR.mkdir(parents=True, exist_ok=True)
    pid_file = PIDS_DIR / str(os.getpid())
    pid_file.touch()
    if cfg["popover"].get("preload"):
        try:
            ensure_popover_daemon()
        except OSError:
            pass

    try:
        snap = load_cache()
        if snap:
            emit(render_snapshot(snap, cfg))  # show last numbers immediately
        while True:
            now = time.time()
            if forced["at"]:
                snap = shared_poll(cfg, forced["at"])
                forced["at"] = 0.0
            elif not snap or now - snap.attempted_at >= cfg["interval"]:
                snap = shared_poll(cfg, now - cfg["interval"])
            emit(render_snapshot(snap, cfg))
            wake.clear()
            # Re-render at least once a minute so reset countdowns tick.
            until_due = cfg["interval"] - (time.time() - snap.attempted_at)
            wake.wait(max(1.0, min(60.0, until_due)))
    except BrokenPipeError:
        return 0
    finally:
        pid_file.unlink(missing_ok=True)


def cmd_once(cfg: dict) -> int:
    snap = poll(cfg)
    emit(render_snapshot(snap, cfg))
    return 1 if snap.error else 0


