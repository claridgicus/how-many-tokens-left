# dithered bars (pure; used by the popover)

BAYER8 = [
    [0, 32, 8, 40, 2, 34, 10, 42],
    [48, 16, 56, 24, 50, 18, 58, 26],
    [12, 44, 4, 36, 14, 46, 6, 38],
    [60, 28, 52, 20, 62, 30, 54, 22],
    [3, 35, 11, 43, 1, 33, 9, 41],
    [51, 19, 59, 27, 49, 17, 57, 25],
    [15, 47, 7, 39, 13, 45, 5, 37],
    [63, 31, 55, 23, 61, 29, 53, 21],
]


def hex_rgb(color: str) -> tuple[int, int, int]:
    c = color.lstrip("#")
    if len(c) == 3:
        c = "".join(ch * 2 for ch in c)
    return int(c[0:2], 16), int(c[2:4], 16), int(c[4:6], 16)


def dither_bar(pct: float | None, width: int, height: int, cell: int,
               fill: tuple[int, int, int], track: tuple[int, int, int],
               strength: float = 1.0) -> bytes:
    """RGBA pixels for an ordered-dither (Bayer 8x8) progress bar.

    The filled part ramps from a sparse dither on the left to solid at the
    leading edge; the empty track is a faint dither in the track colour.
    """
    cell = max(1, cell)
    cols = max(1, -(-width // cell))
    rows = max(1, -(-height // cell))
    filled = 0.0 if pct is None else max(0.0, min(100.0, pct)) / 100 * cols
    fa = int(255 * strength)
    on_fill = bytes((*fill, fa))
    on_track = bytes((*track, 150))
    off = bytes(4)
    cell_rows = []
    for cy in range(rows):
        bay = BAYER8[cy % 8]
        line = bytearray()
        for cx in range(cols):
            t = (bay[cx % 8] + 0.5) / 64
            if cx < filled:
                # ramp 0.35 -> 1.0 towards the leading edge; last cells solid
                density = 1.0 if filled - cx <= 1.5 else 0.35 + 0.65 * (cx / filled) ** 1.6
                px = on_fill if t < density else off
            else:
                px = on_track if t < 0.14 else off
            line += px * cell
        line = bytes(line[: width * 4])
        cell_rows.append(line)
    out = bytearray()
    for y in range(height):
        out += cell_rows[y // cell]
    return bytes(out)


def popover_pid() -> int | None:
    try:
        pid = int(POPOVER_PID.read_text().strip())
        os.kill(pid, 0)
        return pid
    except (OSError, ValueError):
        return None


def _hypr_cursor() -> tuple[str, float] | None:
    """(connector, cursor x relative to that monitor) via Hyprland, if present."""
    import subprocess
    try:
        pos = subprocess.run(["hyprctl", "-j", "cursorpos"], capture_output=True, timeout=2, text=True)
        mons = subprocess.run(["hyprctl", "-j", "monitors"], capture_output=True, timeout=2, text=True)
        cur = json.loads(pos.stdout)
        for m in json.loads(mons.stdout):
            scale = m.get("scale") or 1
            w, h = m["width"] / scale, m["height"] / scale
            if m.get("transform", 0) % 2:
                w, h = h, w
            if m["x"] <= cur["x"] < m["x"] + w and m["y"] <= cur["y"] < m["y"] + h:
                return m["name"], cur["x"] - m["x"]
    except (OSError, ValueError, KeyError, subprocess.SubprocessError):
        pass
    return None


def _find_layer_shell_lib() -> str | None:
    import ctypes.util
    for p in ("/usr/lib/libgtk4-layer-shell.so.0", "/usr/lib64/libgtk4-layer-shell.so.0",
              "/usr/lib/x86_64-linux-gnu/libgtk4-layer-shell.so.0",
              "/usr/lib/aarch64-linux-gnu/libgtk4-layer-shell.so.0"):
        if os.path.exists(p):
            return p
    name = ctypes.util.find_library("gtk4-layer-shell")
    return name


def capture_panel(path: str | None = None, copy: bool = True) -> str:
    """Screenshot the open dropdown with grim; returns the saved path."""
    import shutil
    import subprocess
    if not shutil.which("grim"):
        raise QuotaError("screenshot needs grim")
    geom = None
    try:
        layers = json.loads(subprocess.run(["hyprctl", "-j", "layers"], capture_output=True,
                                           text=True, timeout=2).stdout)
        for mon in layers.values():
            for level in mon.get("levels", {}).values():
                for layer in level:
                    if layer.get("namespace") == APP:
                        # trim the transparent shadow margin (css: 2px 8px 14px 8px)
                        geom = f"{layer['x'] + 8},{layer['y'] + 2} {layer['w'] - 16}x{layer['h'] - 16}"
    except (OSError, ValueError, AttributeError, subprocess.SubprocessError):
        pass
    if not geom:
        raise QuotaError("dropdown isn't open (or not on Hyprland); use your own screenshot tool with `popover --pin`")
    if not path:
        pics = Path(os.environ.get("XDG_PICTURES_DIR") or Path.home() / "Pictures")
        pics.mkdir(parents=True, exist_ok=True)
        path = str(pics / f"tokens-left-{datetime.now():%Y%m%d-%H%M%S}.png")
    subprocess.run(["grim", "-g", geom, path], check=True, timeout=10)
    if copy and shutil.which("wl-copy"):
        with open(path, "rb") as fh:
            subprocess.Popen(["wl-copy", "--type", "image/png"], stdin=fh)
    return path


def _popover_available() -> bool:
    import importlib.util
    return bool(_find_layer_shell_lib()) and importlib.util.find_spec("gi") is not None


def ensure_popover_daemon() -> None:
    """Start the hidden, resident dropdown once (shared by every bar)."""
    import fcntl
    import subprocess
    if popover_pid() or not _popover_available():
        return
    RUN_DIR.mkdir(parents=True, exist_ok=True)
    with open(POPOVER_LOCK, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if popover_pid():
            return
        child = subprocess.Popen(
            [sys.executable, os.path.abspath(__file__), "popover", "--daemon"],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        # The pid survives the daemon's LD_PRELOAD re-exec, so claim it now.
        POPOVER_PID.write_text(str(child.pid))


def cmd_popover(cfg: dict, pin: bool = False, daemon: bool = False) -> int:
    """Without --daemon: toggle the resident panel (starting it if needed).
    With --daemon: be the resident panel, hidden until signalled."""
    pid = popover_pid()
    if pid and pid != os.getpid():
        if daemon:
            return 0  # one is already resident
        os.kill(pid, signal.SIGUSR2 if pin else signal.SIGUSR1)
        return 0
    show_on_start = not daemon

    # gtk4-layer-shell must be loaded before libwayland-client.
    if "gtk4-layer-shell" not in os.environ.get("LD_PRELOAD", ""):
        lib = _find_layer_shell_lib()
        if not lib:
            print(f"{APP}: popover needs gtk4-layer-shell", file=sys.stderr)
            return 1
        env = dict(os.environ)
        env["LD_PRELOAD"] = (lib + " " + env.get("LD_PRELOAD", "")).strip()
        args = ["popover", "--daemon"] + (["--show"] if show_on_start else []) + (["--pin"] if pin else [])
        os.execve(sys.executable, [sys.executable, os.path.abspath(__file__), *args], env)

    try:
        import gi
        gi.require_version("Gtk", "4.0")
        gi.require_version("Gdk", "4.0")
        gi.require_version("Gsk", "4.0")
        gi.require_version("Graphene", "1.0")
        gi.require_version("Gtk4LayerShell", "1.0")
        from gi.repository import Gdk, GLib, Graphene, Gsk, Gtk
        from gi.repository import Gtk4LayerShell as LayerShell
    except (ImportError, ValueError) as e:
        print(f"{APP}: popover needs python-gobject, gtk4 and gtk4-layer-shell ({e})", file=sys.stderr)
        return 1

    pc = cfg["popover"]
    colors = cfg["colors"]
    track_rgb = hex_rgb(colors["dim"])

    class DitherBar(Gtk.Widget):
        def __init__(self, pct, color, strength=1.0, height=10):
            super().__init__()
            self.pct, self.rgb, self.strength = pct, hex_rgb(color), strength
            self.set_size_request(60, height)
            self.set_hexpand(True)
            self.set_valign(Gtk.Align.CENTER)
            self._tex = None
            self._key = None

        def do_snapshot(self, snap):
            w, h = self.get_width(), self.get_height()
            if w <= 0 or h <= 0:
                return
            native = self.get_native()
            surface = native.get_surface() if native else None
            scale = surface.get_scale() if surface and hasattr(surface, "get_scale") else self.get_scale_factor()
            dw, dh = max(1, round(w * scale)), max(1, round(h * scale))
            key = (dw, dh)
            if key != self._key:
                data = dither_bar(self.pct, dw, dh, pc["dither_cell"], self.rgb, track_rgb, self.strength)
                self._tex = Gdk.MemoryTexture.new(dw, dh, Gdk.MemoryFormat.R8G8B8A8, GLib.Bytes.new(data), dw * 4)
                self._key = key
            rect = Graphene.Rect().init(0, 0, w, h)
            snap.append_scaled_texture(self._tex, Gsk.ScalingFilter.NEAREST, rect)

    css = f"""
    window.hmtl {{ background: transparent; }}
    .hmtl-panel {{
        background: {colors['background']};
        color: {colors['foreground']};
        border: 1px solid alpha({colors['foreground']}, 0.14);
        border-radius: 4px;
        padding: 12px 14px 10px 14px;
        font-family: "JetBrainsMono Nerd Font", "JetBrains Mono", monospace;
        font-size: 11px;
        box-shadow: 0 6px 18px rgba(0,0,0,0.55);
        margin: 2px 8px 14px 8px;
    }}
    .hmtl-title {{ font-weight: 900; letter-spacing: 2px; }}
    .hmtl-section {{ font-size: 9px; font-weight: 700; letter-spacing: 2px;
                     color: {colors['dim']}; margin-top: 12px; margin-bottom: 2px; }}
    .hmtl-dim {{ color: {colors['dim']}; }}
    .hmtl-small {{ font-size: 9px; }}
    .hmtl-name {{ font-weight: 800; margin-top: 6px; }}
    .hmtl-pct {{ font-weight: 900; }}
    .hmtl-flash {{ color: {colors['ok']}; }}
    .hmtl-err {{ color: {colors['critical']}; }}
    .hmtl-rule {{ background: alpha({colors['foreground']}, 0.10); min-height: 1px; margin-top: 10px; }}
    button.hmtl-btn {{ background: none; border: none; box-shadow: none; padding: 0 2px;
                       min-height: 0; min-width: 0; color: {colors['dim']}; }}
    button.hmtl-btn:hover {{ color: {colors['foreground']}; }}
    """

    def label(text, *classes, xalign=0.0, markup=False, width_chars=None):
        lbl = Gtk.Label()
        if markup:
            lbl.set_markup(text)
        else:
            lbl.set_text(text)
        lbl.set_xalign(xalign)
        for c in classes:
            lbl.add_css_class(c)
        if width_chars:
            lbl.set_width_chars(width_chars)
        return lbl

    def colored_pct(pct, bold=True):
        col = colors[severity(pct, cfg)]
        weight = "900" if bold else "400"
        return f"<span foreground='{col}' weight='{weight}'>{esc(fmt_pct(pct))}</span>"

    def ago(ts):
        if not ts:
            return "never"
        d = int(time.time() - ts)
        return "just now" if d < 45 else f"{d // 60}m ago" if d < 3600 else f"{d // 3600}h ago"

    def add_row(grid, row, win, pct, emph, reset=None, show_reset=True):
        col = colors[severity(pct, cfg)] if pct is not None else colors["dim"]
        grid.attach(label(win, "hmtl-dim", width_chars=3), 0, row, 1, 1)
        grid.attach(DitherBar(pct, col, 1.0 if emph else 0.45), 1, row, 1, 1)
        grid.attach(label(colored_pct(pct, emph), "hmtl-pct", markup=True, xalign=1.0, width_chars=5), 2, row, 1, 1)
        if show_reset:
            grid.attach(label("↻ " + fmt_reset(reset), "hmtl-dim", "hmtl-small", width_chars=9), 3, row, 1, 1)

    def new_grid():
        g = Gtk.Grid()
        g.set_column_spacing(10)
        g.set_row_spacing(3)
        return g

    def build(panel):
        child = panel.get_first_child()
        while child:
            nxt = child.get_next_sibling()
            panel.remove(child)
            child = nxt

        snap = load_cache()
        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        head.append(label("TOKENS LEFT", "hmtl-title"))
        spacer = Gtk.Box()
        spacer.set_hexpand(True)
        head.append(spacer)
        if state["flash"] and time.time() < state["flash_until"]:
            head.append(label(state["flash"], "hmtl-small", "hmtl-flash"))
        else:
            if state["pinned"]:
                head.append(label("󰐃 pinned", "hmtl-small", "hmtl-flash"))
            head.append(label(f"updated {ago(snap.fetched_at if snap else 0)}", "hmtl-dim", "hmtl-small"))
        btn = Gtk.Button(label="󰑐")
        btn.add_css_class("hmtl-btn")
        btn.set_tooltip_text("Refresh now")
        btn.connect("clicked", lambda *_: signal_running(signal.SIGUSR2))
        head.append(btn)
        panel.append(head)

        if not snap or not snap.accounts:
            msg = (snap.error if snap else "") or "no data yet — is the waybar module running?"
            panel.append(label(msg, "hmtl-err"))
            return

        accounts = snap.accounts
        summary = provider_summary(accounts, cfg)
        how = {"mean": "pooled average", "min": "worst account", "sum": "total"}.get(cfg["aggregate"], "")

        panel.append(label(f"OVERALL · {how.upper()}", "hmtl-section"))
        for provider, wins in summary.items():
            icon = cfg["icons"].get(provider, cfg["icons"].get("default", ""))
            n = sum(1 for a in accounts if a.provider == provider)
            panel.append(label(f"{icon}  <b>{esc(provider.title())}</b>  <span foreground='{colors['dim']}'>{n} account{'s' if n != 1 else ''}</span>",
                               "hmtl-name", markup=True))
            g = new_grid()
            known = [v for v in wins.values() if v is not None]
            low = min(known) if known else None
            for i, (win, val) in enumerate(wins.items()):
                add_row(g, i, win, val, val == low, show_reset=False)
            panel.append(g)

        for provider, wins in summary.items():
            rule = Gtk.Box()
            rule.add_css_class("hmtl-rule")
            panel.append(rule)
            panel.append(label(provider.upper(), "hmtl-section"))
            for a in [a for a in accounts if a.provider == provider]:
                name_bits = f"<b>{esc(a.label)}</b>  <span foreground='{colors['dim']}' size='small'>{esc(a.email)}</span>"
                if a.plan and a.plan.lower() not in ("oauth", "api_key"):
                    name_bits += f"  <span foreground='{colors['dim']}' size='small'>· {esc(a.plan)}</span>"
                if a.source == "cached":
                    name_bits += f"  <span foreground='{colors['warning']}' size='small'>cached</span>"
                panel.append(label(name_bits, "hmtl-name", markup=True))
                if a.source == "none":
                    panel.append(label(f"unavailable: {a.error}", "hmtl-err", "hmtl-small"))
                    continue
                g = new_grid()
                eff = a.effective
                for i, win in enumerate(wins):
                    rem = a.remaining(win)
                    w = a.windows.get(win)
                    add_row(g, i, win, rem, rem == eff, w.resets_at if w else None)
                panel.append(g)

        if snap.error:
            panel.append(label(f"last poll failed: {snap.error}", "hmtl-err", "hmtl-small"))
        hint = label("s screenshot · p pin · r refresh · esc close", "hmtl-dim", "hmtl-small", xalign=1.0)
        hint.set_margin_top(10)
        panel.append(hint)

    app = Gtk.Application(application_id=None)
    state = {"mtime": 0.0, "was_active": False, "pinned": pin, "flash": "",
             "flash_until": 0.0, "built_at": 0.0, "visible": False}
    ui = {}

    def rebuild():
        build(ui["panel"])
        state["built_at"] = time.time()

    def place(win):
        """Move the (unmapped) panel under the cursor on the clicked monitor."""
        for edge in (LayerShell.Edge.LEFT, LayerShell.Edge.RIGHT):
            LayerShell.set_anchor(win, edge, False)
        where = _hypr_cursor() if pc["anchor"] == "cursor" else None
        monitor = None
        if where:
            mons = Gdk.Display.get_default().get_monitors()
            for i in range(mons.get_n_items()):
                m = mons.get_item(i)
                if m.get_connector() == where[0]:
                    monitor = m
        width = pc["width"] + 16  # + panel side margins
        if monitor:
            LayerShell.set_monitor(win, monitor)
            mw = monitor.get_geometry().width
            left = int(min(max(where[1] - width / 2, pc["margin"]), mw - width - pc["margin"]))
            LayerShell.set_anchor(win, LayerShell.Edge.LEFT, True)
            LayerShell.set_margin(win, LayerShell.Edge.LEFT, left)
        elif pc["anchor"] in ("left", "right", "cursor"):
            # "cursor" without Hyprland falls back to the right edge
            edge = LayerShell.Edge.LEFT if pc["anchor"] == "left" else LayerShell.Edge.RIGHT
            LayerShell.set_anchor(win, edge, True)
            LayerShell.set_margin(win, edge, pc["margin"])
        # "center": anchored to TOP only, so the compositor centres it

    def set_open(flag: bool):
        try:
            POPOVER_OPEN.touch() if flag else POPOVER_OPEN.unlink(missing_ok=True)
        except OSError:
            pass
        signal_running(signal.SIGUSR1)  # bars pick up / drop the "open" class

    def show(pinned=False):
        win = ui["win"]
        state["pinned"] = pinned
        state["was_active"] = False
        if time.time() - state["built_at"] > 15 or state["pinned"]:
            rebuild()
        place(win)
        win.set_visible(True)
        win.present()
        state["visible"] = True
        set_open(True)
        # Opening the panel asks the bar for fresh numbers if they're old.
        snap = load_cache()
        if not snap or time.time() - snap.attempted_at > 60:
            signal_running(signal.SIGUSR2)

    def hide():
        if not state["visible"]:
            return
        ui["win"].set_visible(False)
        state["visible"] = False
        state["pinned"] = False
        set_open(False)

    def toggle(pinned=False):
        hide() if state["visible"] else show(pinned)
        return True

    def on_activate(app):
        app.hold()  # stay resident while the window is hidden
        provider = Gtk.CssProvider()
        provider.load_from_string(css) if hasattr(provider, "load_from_string") else provider.load_from_data(css.encode())
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), provider,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        win = Gtk.ApplicationWindow(application=app)
        win.add_css_class("hmtl")
        win.set_decorated(False)
        win.set_resizable(False)
        win.set_hide_on_close(True)

        LayerShell.init_for_window(win)
        LayerShell.set_namespace(win, APP)
        LayerShell.set_layer(win, LayerShell.Layer.TOP)
        LayerShell.set_keyboard_mode(win, LayerShell.KeyboardMode.ON_DEMAND)
        LayerShell.set_exclusive_zone(win, 0)  # sit below the bar, don't push windows
        LayerShell.set_anchor(win, LayerShell.Edge.TOP, True)

        panel = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        panel.add_css_class("hmtl-panel")
        panel.set_size_request(pc["width"], -1)
        win.set_child(panel)
        ui["win"], ui["panel"] = win, panel
        rebuild()

        keys = Gtk.EventControllerKey()

        def flash(msg, secs=4):
            state["flash"], state["flash_until"] = msg, time.time() + secs
            rebuild()
            GLib.timeout_add(int(secs * 1000) + 50, lambda: (rebuild(), False)[1])

        def shoot():
            try:
                path = capture_panel()
                flash("󰄀 saved " + path.replace(str(Path.home()), "~") + " (copied)")
            except Exception as e:  # noqa: BLE001 - show anything
                flash(f"screenshot failed: {e}")
            return False

        def on_key(_c, kv, *_):
            if kv == Gdk.KEY_Escape:
                hide()
            elif kv in (Gdk.KEY_s, Gdk.KEY_S):
                GLib.timeout_add(120, shoot)  # let any key-repeat redraw settle
            elif kv in (Gdk.KEY_p, Gdk.KEY_P):
                state["pinned"] = not state["pinned"]
                flash("󰐃 pinned — stays open for other tools" if state["pinned"] else "unpinned", 2)
            elif kv in (Gdk.KEY_r, Gdk.KEY_R):
                signal_running(signal.SIGUSR2)
                flash("refreshing…", 2)
            else:
                return False
            return True

        keys.connect("key-pressed", on_key)
        win.add_controller(keys)

        def on_active(*_):
            if not state["visible"]:
                return
            if win.is_active():
                state["was_active"] = True
            elif state["was_active"] and pc["close_on_focus_loss"] and not state["pinned"]:
                hide()
        win.connect("notify::is-active", on_active)

        def tick():
            # Keep the hidden panel current so showing it is just a map.
            try:
                mtime = CACHE_PATH.stat().st_mtime
            except OSError:
                mtime = 0
            if mtime != state["mtime"] or (state["visible"] and time.time() - state["built_at"] > 30):
                state["mtime"] = mtime
                rebuild()
            return True
        GLib.timeout_add_seconds(2, tick)

        win.realize()  # create the surface + renderer now, not on first click
        if show_on_start:
            show(pin)

    app.connect("activate", on_activate)
    RUN_DIR.mkdir(parents=True, exist_ok=True)
    POPOVER_PID.write_text(str(os.getpid()))
    POPOVER_OPEN.unlink(missing_ok=True)
    try:
        gi.require_version("GLibUnix", "2.0")
        from gi.repository import GLibUnix
        add_signal = GLibUnix.signal_add
    except (ImportError, ValueError):
        add_signal = GLib.unix_signal_add
    add_signal(GLib.PRIORITY_HIGH, signal.SIGUSR1, lambda *_: toggle(False))
    add_signal(GLib.PRIORITY_HIGH, signal.SIGUSR2, lambda *_: toggle(True))
    for sig in (signal.SIGTERM, signal.SIGINT):
        add_signal(GLib.PRIORITY_DEFAULT, sig, lambda *_: (app.quit(), False)[1])
    try:
        app.run([])
    finally:
        try:
            if POPOVER_PID.read_text().strip() == str(os.getpid()):
                POPOVER_PID.unlink()
        except OSError:
            pass
        POPOVER_OPEN.unlink(missing_ok=True)
        signal_running(signal.SIGUSR1)
    return 0


def signal_running(sig: int) -> int:
    pids = running_pids()
    for pid in pids:
        try:
            os.kill(pid, sig)
        except OSError:
            pass
    if not pids:
        print(f"{APP}: no running waybar module found", file=sys.stderr)
        return 1
    return 0


def cmd_toggle() -> int:
    RUN_DIR.mkdir(parents=True, exist_ok=True)
    if EXPANDED_FLAG.exists():
        EXPANDED_FLAG.unlink(missing_ok=True)
    else:
        EXPANDED_FLAG.touch()
    return signal_running(signal.SIGUSR1)


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(prog=APP, description=__doc__.split("\n\n")[0])
    ap.add_argument("command", nargs="?", default="waybar",
                    choices=["waybar", "once", "status", "toggle", "refresh", "popover", "screenshot", "dashboard"])
    ap.add_argument("-c", "--config", type=Path, help=f"config file (default {CONFIG_PATH})")
    ap.add_argument("--json", action="store_true", help="status: print JSON")
    ap.add_argument("--pin", action="store_true", help="popover: don't close when focus moves away")
    ap.add_argument("--daemon", action="store_true", help=argparse.SUPPRESS)
    ap.add_argument("--show", action="store_true", help=argparse.SUPPRESS)
    ap.add_argument("-o", "--output", help="screenshot: file to write (default ~/Pictures/tokens-left-*.png)")
    ap.add_argument("--version", action="version", version=f"{APP} {VERSION}")
    args = ap.parse_args(argv)

    if args.command == "toggle":
        return cmd_toggle()
    if args.command == "refresh":
        return signal_running(signal.SIGUSR2)

    try:
        cfg = load_config(args.config)
    except (OSError, tomllib.TOMLDecodeError) as e:
        print(f"{APP}: bad config: {e}", file=sys.stderr)
        return 2

    if args.command == "popover":
        return cmd_popover(cfg, pin=args.pin, daemon=args.daemon and not args.show)
    if args.command == "screenshot":
        try:
            print(capture_panel(args.output))
            return 0
        except Exception as e:  # noqa: BLE001 - grim/hyprctl failures
            print(f"{APP}: {e}", file=sys.stderr)
            return 1
    if args.command == "dashboard":
        import subprocess
        subprocess.Popen(["xdg-open", cfg["url"] + "/management.html#/quota"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return 0
    if args.command == "once":
        return cmd_once(cfg)
    if args.command == "status":
        return cmd_status(cfg, args.json)
    return cmd_waybar(cfg)


if __name__ == "__main__":
    sys.exit(main())
