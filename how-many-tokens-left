# --------------------------------------------------------------------------
# config


def load_config(path: Path | None = None) -> dict:
    cfg = json.loads(json.dumps(DEFAULTS))
    path = path or CONFIG_PATH
    if path.exists():
        with path.open("rb") as fh:
            user = tomllib.load(fh)
        for key, value in user.items():
            if isinstance(value, dict) and isinstance(cfg.get(key), dict):
                cfg[key].update(value)
            else:
                cfg[key] = value
    if os.environ.get("HMTL_URL"):
        cfg["url"] = os.environ["HMTL_URL"]
    if os.environ.get("HMTL_MANAGEMENT_KEY"):
        cfg["management_key"] = os.environ["HMTL_MANAGEMENT_KEY"]
    cfg["url"] = cfg["url"].rstrip("/")
    return cfg


def resolve_key(cfg: dict) -> str:
    if cfg.get("management_key"):
        return cfg["management_key"].strip()
    candidates = []
    if cfg.get("management_key_file"):
        candidates.append(Path(os.path.expanduser(cfg["management_key_file"])))
    candidates += KEY_FILE_CANDIDATES
    for p in candidates:
        try:
            key = p.read_text().strip()
        except OSError:
            continue
        if key:
            return key
    raise QuotaError(
        "no management key: set management_key in "
        f"{CONFIG_PATH} or HMTL_MANAGEMENT_KEY"
    )


# --------------------------------------------------------------------------
# model


class QuotaError(Exception):
    pass


@dataclass
class Window:
    used: float  # percent 0-100
    resets_at: float | None = None  # epoch seconds

    @property
    def remaining(self) -> float:
        return max(0.0, min(100.0, 100.0 - self.used))


@dataclass
class Account:
    provider: str
    email: str
    label: str
    status: str = "active"
    disabled: bool = False
    plan: str = ""
    windows: dict[str, Window] = field(default_factory=dict)
    source: str = "live"  # live | cached | none
    error: str = ""

    def remaining(self, win: str) -> float | None:
        if self.source == "none":
            return None
        w = self.windows.get(win)
        # No active window (e.g. Claude returns five_hour: null when idle)
        # means nothing has been consumed in it yet.
        return w.remaining if w else 100.0

    def has_window(self, win: str) -> bool:
        return win in self.windows

    @property
    def effective(self) -> float | None:
        vals = [self.remaining(w) for w in WINDOWS]
        vals = [v for v in vals if v is not None]
        return min(vals) if vals else None


# --------------------------------------------------------------------------
# fetching


class Client:
    def __init__(self, cfg: dict):
        self.base = cfg["url"] + "/v0/management"
        self.key = resolve_key(cfg)
        self.timeout = cfg["timeout"]

    def _req(self, method: str, path: str, body: dict | None = None) -> dict:
        data = json.dumps(body).encode() if body is not None else None
        req = urllib.request.Request(
            self.base + path,
            data=data,
            method=method,
            headers={
                "Authorization": f"Bearer {self.key}",
                "Content-Type": "application/json",
            },
        )
        try:
            with urllib.request.urlopen(req, timeout=self.timeout) as resp:
                return json.loads(resp.read() or b"{}")
        except urllib.error.HTTPError as e:
            if e.code in (401, 403):
                raise QuotaError("management key rejected") from e
            raise QuotaError(f"management API HTTP {e.code}") from e
        except (urllib.error.URLError, TimeoutError, OSError) as e:
            raise QuotaError(f"cannot reach {self.base}: {e}") from e

    def auth_files(self) -> list[dict]:
        return self._req("GET", "/auth-files").get("files", [])

    def api_call(self, auth_index: str, url: str, headers: dict) -> dict:
        resp = self._req(
            "POST",
            "/api-call",
            {"auth_index": auth_index, "method": "GET", "url": url, "header": headers},
        )
        code = int(resp.get("status_code") or 0)
        body = resp.get("body")
        if isinstance(body, str):
            try:
                body = json.loads(body)
            except ValueError:
                pass
        if not 200 <= code < 300:
            raise QuotaError(f"upstream HTTP {code}")
        if not isinstance(body, dict):
            raise QuotaError("upstream returned no JSON")
        return body


def _iso_to_epoch(value) -> float | None:
    if not value:
        return None
    if isinstance(value, (int, float)):
        return float(value)
    try:
        return datetime.fromisoformat(str(value).replace("Z", "+00:00")).timestamp()
    except ValueError:
        try:
            return float(value)
        except ValueError:
            return None


def _window_name(seconds: float | None) -> str | None:
    if not seconds:
        return None
    hours = seconds / 3600
    if hours <= 6:
        return FIVE_HOUR
    if 6 * 24 <= hours <= 8 * 24:
        return WEEKLY
    return None


def parse_claude_usage(body: dict) -> dict[str, Window]:
    out = {}
    for key, win in (("five_hour", FIVE_HOUR), ("seven_day", WEEKLY)):
        w = body.get(key)
        if isinstance(w, dict) and w.get("utilization") is not None:
            out[win] = Window(float(w["utilization"]), _iso_to_epoch(w.get("resets_at")))
    return out


def parse_codex_usage(body: dict) -> dict[str, Window]:
    out = {}
    rl = body.get("rate_limit") or {}
    for key in ("primary_window", "secondary_window"):
        w = rl.get(key)
        if not isinstance(w, dict) or w.get("used_percent") is None:
            continue
        name = _window_name(w.get("limit_window_seconds"))
        if name:
            reset = w.get("reset_at")
            if reset is None and w.get("reset_after_seconds") is not None:
                reset = time.time() + float(w["reset_after_seconds"])
            out[name] = Window(float(w["used_percent"]), _iso_to_epoch(reset))
    return out


def parse_signals(provider: str, signals: dict) -> dict[str, Window]:
    """Quota headers CLIProxyAPI recorded from the last proxied request."""
    s = {k.lower(): v for k, v in (signals or {}).items()}
    out = {}
    if provider == "claude":
        for tag, win in (("5h", FIVE_HOUR), ("7d", WEEKLY)):
            util = s.get(f"anthropic-ratelimit-unified-{tag}-utilization")
            if util is None:
                continue
            reset = _iso_to_epoch(s.get(f"anthropic-ratelimit-unified-{tag}-reset"))
            if reset and reset < time.time():
                continue  # window already rolled over; data is stale
            out[win] = Window(float(util) * 100, reset)
    elif provider == "codex":
        for slot in ("primary", "secondary"):
            minutes = s.get(f"x-codex-{slot}-window-minutes")
            used = s.get(f"x-codex-{slot}-used-percent")
            name = _window_name(float(minutes) * 60) if minutes else None
            if name and used is not None:
                reset = _iso_to_epoch(s.get(f"x-codex-{slot}-reset-at"))
                if reset and reset < time.time():
                    continue
                out[name] = Window(float(used), reset)
    return out


def make_label(email: str, aliases: dict) -> str:
    if email in aliases:
        return aliases[email]
    if "@" in email:
        local, domain = email.split("@", 1)
        return domain.split(".")[0] or local
    return email or "?"


FETCHERS = {
    "claude": (CLAUDE_USAGE_URL, CLAUDE_HEADERS, parse_claude_usage),
    "codex": (CODEX_USAGE_URL, CODEX_HEADERS, parse_codex_usage),
}


def fetch_account(client: Client, f: dict, cfg: dict) -> Account:
    provider = f.get("type") or f.get("provider")
    email = f.get("email") or f.get("account") or f.get("name", "")
    acct = Account(
        provider=provider,
        email=email,
        label=make_label(email, cfg["aliases"]),
        status=f.get("status", ""),
        disabled=bool(f.get("disabled")),
        plan=((f.get("id_token") or {}).get("plan_type") or f.get("account_type") or ""),
    )
    url, headers, parser = FETCHERS[provider]
    headers = dict(headers)
    if provider == "codex":
        acct_id = (f.get("id_token") or {}).get("chatgpt_account_id")
        if acct_id:
            headers["Chatgpt-Account-Id"] = acct_id
    try:
        body = client.api_call(f["auth_index"], url, headers)
        acct.windows = parser(body)
        if provider == "codex" and body.get("plan_type"):
            acct.plan = body["plan_type"]
    except (QuotaError, KeyError) as e:
        acct.error = str(e)
        acct.windows = parse_signals(provider, (f.get("quota") or {}).get("signals"))
        acct.source = "cached" if acct.windows else "none"
    return acct


def fetch_all(cfg: dict) -> list[Account]:
    client = Client(cfg)
    files = [
        f
        for f in client.auth_files()
        if (f.get("type") or f.get("provider")) in cfg["providers"]
        and (f.get("type") or f.get("provider")) in FETCHERS
        and f.get("auth_index")
        and (cfg["show_disabled"] or not f.get("disabled"))
    ]
    with ThreadPoolExecutor(max_workers=8) as pool:
        accounts = list(pool.map(lambda f: fetch_account(client, f, cfg), files))
    order = {p: i for i, p in enumerate(cfg["providers"])}
    accounts.sort(key=lambda a: (order.get(a.provider, 99), a.email))
    return accounts


# --------------------------------------------------------------------------
# aggregation


def pool(accounts: list[Account], win: str, how: str) -> float | None:
    vals = [a.remaining(win) for a in accounts if not a.disabled]
    vals = [v for v in vals if v is not None]
    if not vals:
        return None
    if how == "min":
        return min(vals)
    if how == "sum":
        return sum(vals)
    return sum(vals) / len(vals)


def provider_summary(accounts: list[Account], cfg: dict) -> dict[str, dict]:
    out = {}
    for provider in cfg["providers"]:
        accts = [a for a in accounts if a.provider == provider]
        if not accts:
            continue
        wins = {}
        for win in WINDOWS:
            # Only show a window if at least one account actually has it.
            if any(a.has_window(win) for a in accts):
                wins[win] = pool(accts, win, cfg["aggregate"])
        if not wins:
            wins[WEEKLY] = pool(accts, WEEKLY, cfg["aggregate"])
        out[provider] = wins
    return out


def severity(pct: float | None, cfg: dict) -> str:
    if pct is None:
        return "error"
    if pct < cfg["critical"]:
        return "critical"
    if pct < cfg["warning"]:
        return "warning"
    return "ok"


# --------------------------------------------------------------------------
# rendering


def esc(s: str) -> str:
    return html.escape(str(s), quote=False)


def span(text: str, color: str | None = None, bold: bool = False, alpha: str | None = None) -> str:
    attrs = []
    if color:
        attrs.append(f"foreground='{color}'")
    if bold:
        attrs.append("weight='bold'")
    if alpha:
        attrs.append(f"alpha='{alpha}'")
    return f"<span {' '.join(attrs)}>{text}</span>" if attrs else text


def fmt_pct(p: float | None) -> str:
    return "?" if p is None else f"{p:.0f}%"


def fmt_reset(epoch: float | None, now: float | None = None) -> str:
    if not epoch:
        return "—"
    delta = int(epoch - (now or time.time()))
    if delta <= 0:
        return "now"
    d, rem = divmod(delta, 86400)
    h, rem = divmod(rem, 3600)
    m = rem // 60
    if d:
        return f"{d}d {h}h"
    if h:
        return f"{h}h {m:02d}m"
    return f"{m}m"


def meter(pct: float | None, width: int) -> str:
    if pct is None:
        return "·" * width
    filled = round(pct / 100 * width)
    filled = max(0, min(width, filled))
    return "█" * filled + "░" * (width - filled)


def render_windows(wins: dict[str, float | None], cfg: dict) -> str:
    """'5h 72% · 7d 38%' with the binding (smallest) window highlighted."""
    known = [v for v in wins.values() if v is not None]
    lowest = min(known) if known else None
    parts = []
    for win, val in wins.items():
        txt = f"{win} {fmt_pct(val)}"
        if val is not None and val == lowest:
            parts.append(span(esc(txt), cfg["colors"][severity(val, cfg)], bold=True))
        else:
            parts.append(span(esc(txt), cfg["colors"]["dim"]))
    return " ".join(parts)


def render_text(accounts: list[Account], cfg: dict, expanded: bool) -> str:
    summary = provider_summary(accounts, cfg)
    icons = cfg["icons"]
    chunks = []
    for provider, wins in summary.items():
        icon = icons.get(provider, icons.get("default", ""))
        if expanded:
            accts = [a for a in accounts if a.provider == provider]
            per = []
            for a in accts:
                eff = a.effective
                col = cfg["colors"][severity(eff, cfg)]
                per.append(f"{esc(a.label)} {span(fmt_pct(eff), col, bold=True)}")
            chunks.append(f"{icon} " + span(" · ", cfg["colors"]["dim"]).join(per))
        else:
            chunks.append(f"{icon} {render_windows(wins, cfg)}")
    if not chunks:
        return f"{icons.get('default', '')} –"
    return span("  │  ", cfg["colors"]["dim"]).join(chunks)


def render_tooltip(accounts: list[Account], cfg: dict, fetched_at: float) -> str:
    summary = provider_summary(accounts, cfg)
    width = cfg["bar_width"]
    label_w = max([len(a.label) for a in accounts] + [6])
    lines = [
        span("How Many Tokens Left", bold=True)
        + span(f"   updated {datetime.fromtimestamp(fetched_at).strftime('%H:%M')}", cfg["colors"]["dim"])
    ]
    for provider, wins in summary.items():
        icon = cfg["icons"].get(provider, cfg["icons"].get("default", ""))
        how = {"mean": "pool", "min": "worst", "sum": "total"}.get(cfg["aggregate"], "")
        lines.append("")
        lines.append(f"{icon} {span(provider.title(), bold=True)}  {span(how, cfg['colors']['dim'])} {render_windows(wins, cfg)}")
        for a in [a for a in accounts if a.provider == provider]:
            name = esc(a.label.ljust(label_w))
            if a.source == "none":
                lines.append(f"  {name}  " + span(esc(f"unavailable: {a.error}"), cfg["colors"]["critical"]))
                continue
            cells = []
            for win in wins:
                rem = a.remaining(win)
                w = a.windows.get(win)
                col = cfg["colors"][severity(rem, cfg)]
                eff = a.effective
                bold = rem is not None and eff is not None and rem == eff
                cells.append(
                    f"{win} "
                    + span(meter(rem, width), col)
                    + " "
                    + span(fmt_pct(rem).rjust(4), col, bold=bold)
                    + span(" ↻ " + fmt_reset(w.resets_at if w else None).ljust(7), cfg["colors"]["dim"])
                )
            tag = ""
            if a.source == "cached":
                tag = span("  (cached)", cfg["colors"]["warning"])
            if a.disabled:
                tag += span("  (disabled)", cfg["colors"]["dim"])
            lines.append(f"  {name}  " + "  ".join(cells) + tag)
    lines.append("")
    lines.append(span("click: details · right-click: refresh · middle: dashboard", cfg["colors"]["dim"]))
    return f"<tt>{chr(10).join(lines)}</tt>"


def render_waybar(accounts: list[Account], cfg: dict, expanded: bool, fetched_at: float) -> dict:
    summary = provider_summary(accounts, cfg)
    known = [v for wins in summary.values() for v in wins.values() if v is not None]
    lowest = min(known) if known else None
    sev = severity(lowest, cfg)
    classes = [sev]
    if expanded:
        classes.append("expanded")
    return {
        "text": render_text(accounts, cfg, expanded),
        "tooltip": render_tooltip(accounts, cfg, fetched_at),
        "class": classes,
        "percentage": int(round(lowest)) if lowest is not None else 0,
        "alt": sev,
    }


def render_error(err: str, cfg: dict) -> dict:
    icon = cfg["icons"].get("default", "")
    return {
        "text": f"{icon} {span('!', cfg['colors']['critical'], bold=True)}",
        "tooltip": f"<tt>{span('How Many Tokens Left', bold=True)}\n\n{esc(err)}</tt>",
        "class": ["error"],
        "percentage": 0,
        "alt": "error",
    }


# --------------------------------------------------------------------------
# state & cache
#
# Waybar starts one module process per bar (i.e. per monitor). They share
# one cache + lock so only one of them polls the API, and one runtime dir
# so a click toggles every bar at once.

RUN_DIR = XDG_RUNTIME / APP
PIDS_DIR = RUN_DIR / "pids"
EXPANDED_FLAG = RUN_DIR / "expanded"
POPOVER_PID = RUN_DIR / "popover.pid"
POPOVER_OPEN = RUN_DIR / "popover-open"
POPOVER_LOCK = RUN_DIR / "popover.lock"
LOCK_PATH = RUN_DIR / "fetch.lock"


@dataclass
class Snapshot:
    accounts: list[Account]
    fetched_at: float = 0.0  # last successful poll
    attempted_at: float = 0.0  # last poll attempt, successful or not
    error: str = ""


def save_cache(snap: Snapshot) -> None:
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        data = {
            "fetched_at": snap.fetched_at,
            "attempted_at": snap.attempted_at,
            "error": snap.error,
            "accounts": [
                {
                    **{k: v for k, v in a.__dict__.items() if k != "windows"},
                    "windows": {k: w.__dict__ for k, w in a.windows.items()},
                }
                for a in snap.accounts
            ],
        }
        tmp = CACHE_PATH.with_suffix(f".{os.getpid()}.tmp")
        tmp.write_text(json.dumps(data, indent=1))
        tmp.replace(CACHE_PATH)
    except OSError:
        pass


def demo_snapshot() -> Snapshot:
    """Made-up accounts for screenshots and trying the UI (HMTL_DEMO=1)."""
    now = time.time()
    h, d = 3600, 86400

    def a(provider, email, label, plan="", **wins):
        w = {k[1:]: Window(used, now + reset) for k, (used, reset) in wins.items()}
        return Account(provider, email, label, plan=plan, windows=w)

    return Snapshot([
        a("claude", "ada@example.com", "work", "max", w5h=(38, 2 * h + 14 * 60), w7d=(71, 3 * d + 5 * h)),
        a("claude", "ada@personal.dev", "personal", "max", w7d=(22, 6 * d + 1 * h)),
        a("claude", "ada@sideproject.io", "side", "pro", w5h=(91, 41 * 60), w7d=(64, 1 * d + 9 * h)),
        a("claude", "ada@lab.example.org", "lab", "pro", w7d=(100, 9 * h + 30 * 60)),
        a("codex", "ada@example.com", "work", "pro", w7d=(43, 4 * d + 2 * h)),
    ], now, now)


def load_cache() -> Snapshot | None:
    if os.environ.get("HMTL_DEMO"):
        return demo_snapshot()
    try:
        data = json.loads(CACHE_PATH.read_text())
        accounts = []
        for a in data.get("accounts", []):
            wins = {k: Window(**w) for k, w in a.pop("windows", {}).items()}
            accounts.append(Account(**a, windows=wins))
    except (OSError, ValueError, TypeError):
        return None
    fetched = data.get("fetched_at", 0)
    return Snapshot(accounts, fetched, data.get("attempted_at", fetched), data.get("error", ""))


def poll(cfg: dict) -> Snapshot:
    """Fetch now, keeping the previous accounts if the poll fails."""
    if os.environ.get("HMTL_DEMO"):
        return demo_snapshot()
    now = time.time()
    try:
        snap = Snapshot(fetch_all(cfg), now, now)
    except QuotaError as e:
        prev = load_cache() or Snapshot([])
        snap = Snapshot(prev.accounts, prev.fetched_at, now, str(e))
    save_cache(snap)
    return snap


def shared_poll(cfg: dict, newer_than: float) -> Snapshot:
    """Return a snapshot attempted at or after `newer_than`, polling only if
    no other module process already has one."""
    if os.environ.get("HMTL_DEMO"):
        return demo_snapshot()
    import fcntl

    RUN_DIR.mkdir(parents=True, exist_ok=True)
    with open(LOCK_PATH, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        snap = load_cache()
        if snap and snap.attempted_at >= newer_than:
            return snap
        return poll(cfg)


def is_expanded() -> bool:
    return EXPANDED_FLAG.exists()


def running_pids() -> list[int]:
    pids = []
    try:
        entries = list(PIDS_DIR.iterdir())
    except OSError:
        return pids
    for entry in entries:
        try:
            pid = int(entry.name)
            os.kill(pid, 0)
            pids.append(pid)
        except (ValueError, ProcessLookupError):
            entry.unlink(missing_ok=True)
        except PermissionError:
            pass
    return pids


