#!/usr/bin/env python3
"""how-many-tokens-left: Waybar module showing CLIProxyAPI account quotas.

Polls a CLIProxyAPI management server (the same API behind
/management.html#/quota) for 5-hour and weekly usage on every Claude and
Codex account, and renders it as Waybar custom-module JSON.

Subcommands:
  waybar    run as a continuous Waybar module (default)
  once      print a single Waybar JSON line and exit
  status    print a human-readable table to the terminal
  toggle    expand/collapse the per-account view in the bar
  refresh   make the running module re-poll right now
  popover   open/close the dropdown panel (GTK4 + gtk4-layer-shell)
            --pin keeps it open when focus moves (for screenshot tools)
  screenshot  save + copy a PNG of the open dropdown (grim, Hyprland)
  dashboard open the CLIProxyAPI quota page in a browser

Stdlib only; needs Python 3.11+.
"""

from __future__ import annotations

import os
import sys

# Fast path for clicks: if the resident dropdown is running, poke it and exit
# before importing anything heavy, so the panel reacts instantly.
if len(sys.argv) > 1 and sys.argv[1] == "popover" and "--daemon" not in sys.argv[2:]:
    try:
        import signal as _signal
        _pidfile = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp",
                                "how-many-tokens-left", "popover.pid")
        with open(_pidfile) as _fh:
            os.kill(int(_fh.read().strip()),
                    _signal.SIGUSR2 if "--pin" in sys.argv[2:] else _signal.SIGUSR1)
        sys.exit(0)
    except (OSError, ValueError):
        pass  # not running yet: fall through and start it

